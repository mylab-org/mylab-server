# ================================
# .env.example
# 이 파일을 .env로 복사 후 값 채우기
# ================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mylab
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mylab

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Email (Gmail 앱 비밀번호 필요)
SMTP_USER=noreply.myla3@gmail.com
SMTP_PASS=

# Server (Service: 8080, Dev: 8081)
PORT=8080

# Client (Service: 3000, Dev: 3001)
CLIENT_URL=http://localhost:3000